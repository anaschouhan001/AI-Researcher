# ============================================================
# ResearchGPT — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000

# --- LLM providers (priority: gemini > openrouter > groq > ollama) ---
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_PROVIDER_PRIORITY=gemini,openrouter,groq,ollama
GEMINI_MODEL=gemini-2.5-pro
OPENROUTER_MODEL=deepseek/deepseek-chat
OLLAMA_MODEL=llama3.1

# --- Search / research sources ---
SERPAPI_KEY=
TAVILY_API_KEY=
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
GNEWS_API_KEY=
NEWS_API_KEY=
SEMANTIC_SCHOLAR_KEY=
PUBMED_API_KEY=
OPENALEX_EMAIL=research@example.com

# --- Audio (Sarvam AI) ---
SARVAM_API_KEY=

# --- Infrastructure ---
# SQLite by default; any SQLAlchemy async URL works (e.g. postgresql+asyncpg://...)
DATABASE_URL=sqlite+aiosqlite:///./researchgpt.db
SYNC_DATABASE_URL=sqlite:///./researchgpt.db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CHROMA_PERSIST_DIR=./chroma_data
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Behaviour ---
CACHE_TTL_SECONDS=86400
HTTP_TIMEOUT_SECONDS=30
MAX_RETRIES=3
STORAGE_DIR=./storage
